<Window x:Class="Nuvora.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nuvora" Width="1180" Height="760" MinWidth="900" MinHeight="600" Background="#0B0D12" Foreground="#F4F6FA">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="NUVORA" FontSize="32" FontWeight="Bold"/><TextBlock Text="Seu fluxo de notícias, podcasts e transmissões." Foreground="#9BA3B4" FontSize="15"/></StackPanel>
<Border Grid.Row="1" Margin="0,24,0,18" Padding="18" Background="#151923" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FeedUrl" Height="38" Padding="10" VerticalContentAlignment="Center" ToolTip="Cole um RSS/Atom/Podcast feed"/><Button Grid.Column="1" Margin="12,0,0,0" Padding="22,0" Content="Adicionar e atualizar" Click="Add_Click"/></Grid></Border>
<ListBox Grid.Row="2" x:Name="Items" Background="Transparent" BorderThickness="0" MouseDoubleClick="Items_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,10" Padding="16" Background="#151923" CornerRadius="10"><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SourceName}" Margin="0,6,0,0" Foreground="#8EA0C9"/><TextBlock Text="{Binding Summary}" Margin="0,7,0,0" Foreground="#B7BDCA" TextWrapping="Wrap" MaxHeight="44"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border Grid.Row="3" Margin="0,18,0,0" Padding="14" Background="#151923" CornerRadius="10"><DockPanel><Button Content="◀ 15s" Click="Back_Click"/><Button Content="▶ / ❚❚" Margin="8,0" Click="PlayPause_Click"/><Button Content="15s ▶" Click="Forward_Click"/><TextBlock x:Name="NowPlaying" Margin="18,0,0,0" VerticalAlignment="Center" Text="Nenhum podcast tocando" Foreground="#B7BDCA"/><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed"/></DockPanel></Border>
</Grid></Window>
