<Window x:Class="Nuvora.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Nuvora" Width="1280" Height="820" MinWidth="1020" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#F5F4F0" Foreground="#171717"
 FontFamily="Segoe UI Variable Text">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#171717"/><SolidColorBrush x:Key="Muted" Color="#6B6B67"/>
  <SolidColorBrush x:Key="Paper" Color="#F5F4F0"/><SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Line" Color="#E1E0DB"/><SolidColorBrush x:Key="Accent" Color="#315C4A"/>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#ECEBE6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="nuvora" FontFamily="Georgia" FontWeight="Bold" FontSize="30"/><TextBlock Text="seu radar pessoal" Foreground="{StaticResource Muted}" FontSize="12" Margin="1,-2,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,34,0,0">
     <Button Style="{StaticResource NavButton}" Content="Hoje" Click="Today_Click"/><Button Style="{StaticResource NavButton}" Content="Podcasts" Click="Podcasts_Click"/><Button Style="{StaticResource NavButton}" Content="Ao vivo" Click="Live_Click"/><Button Style="{StaticResource NavButton}" Content="Biblioteca" Click="Library_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="3"><Separator Margin="0,0,0,12" Background="{StaticResource Line}"/><TextBlock Text="NUVORA DESKTOP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="StatusText" Text="Pronto" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,38,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="Hoje" FontFamily="Georgia" FontSize="34" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Notícias e episódios recentes, sem ruído." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="1" Content="+ Adicionar fonte" Background="{StaticResource Ink}" Foreground="White" Padding="18,10" Click="ToggleAdd_Click"/>
   </Grid>
   <Border x:Name="AddPanel" Grid.Row="1" Margin="0,22,0,18" Padding="16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="FeedUrl" Height="40" Padding="12,0" VerticalContentAlignment="Center" BorderBrush="#CBCAC4" ToolTip="RSS ou feed de podcast" Text=""/>
     <Button Grid.Column="1" Margin="10,0,0,0" Content="Adicionar" Background="{StaticResource Accent}" Foreground="White" Click="Add_Click"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_DoubleClick">
     <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,10" Padding="18" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="{Binding SourceName}" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding PublishedAt, StringFormat={}{0:dd MMM · HH:mm}}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="0,8,0,0" FontFamily="Georgia" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="0,7,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="40"/>
     </Grid></Border></DataTemplate>
    </ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Column="1" Margin="24,0,0,0">
     <TextBlock Text="RADARES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
     <Border Margin="0,10,0,0" Padding="16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7"><StackPanel><TextBlock Text="Assine o que importa" FontFamily="Georgia" FontSize="18" FontWeight="Bold"/><TextBlock Text="Adicione feeds de notícias e podcasts. Busca por catálogo e agendamentos entram na próxima camada." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><Button Content="Adicionar fonte" HorizontalAlignment="Left" Margin="-14,8,0,-9" Foreground="{StaticResource Accent}" Click="ToggleAdd_Click"/></StackPanel></Border>
     <TextBlock Text="ATALHOS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,24,0,10"/>
     <Button Content="Atualizar tudo" HorizontalAlignment="Stretch" Background="#ECEBE6" Click="Refresh_Click"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="3" Margin="0,18,0,0" Padding="13" Background="#1C1C1B" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Button Content="−15" Foreground="White" Click="Back_Click"/><Button x:Name="PlayButton" Content="▶" Foreground="White" FontSize="18" Click="PlayPause_Click"/><Button Content="+15" Foreground="White" Click="Forward_Click"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="TOCANDO AGORA" Foreground="#9D9D98" FontSize="9"/><TextBlock x:Name="NowPlaying" Text="Nenhum episódio selecionado" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/></StackPanel>
    <TextBlock Grid.Column="2" x:Name="PlaybackTime" Text="00:00" Foreground="#BDBDB7" VerticalAlignment="Center"/><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Visibility="Collapsed" MediaOpened="Player_MediaOpened"/>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>